---
import Prose from './Prose.astro';
import experience from '../data/experience.json';
---

<section id="experience">
  <div class="wrap">
    <p class="mono eyebrow">Experience</p>
    {
      experience.map((role, i) => (
        <div class="reveal">
          <div class:list={['role', { current: role.current, first: i === 0 }]}>
            <div class="role-when mono">
              <div class="role-year">{role.year}</div>
              {role.period}
            </div>
            <div>
              <div class="role-co">
                <h3>{role.company}</h3>
                {role.current && <span class="badge">Current</span>}
                {role.badges.map((badge) => (
                  <span class="badge badge-accent">{badge}</span>
                ))}
                <span class="disc">{role.discipline}</span>
              </div>
              <p class="role-title">
                {role.title} <span class="sep">·</span> {role.location}
              </p>
              <ul class="bullets">
                {role.highlights.map((text) => (
                  <Prose as="li" text={text} />
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .role {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
    padding-block: 2.1rem;
    border-top: 1px solid var(--rule);
  }

  /* the section heading's underline is this section's top rule, keeping a
     border here too produced two parallel lines 30px apart */
  .role.first {
    border-top: none;
  }

  .role-when {
    color: var(--ink-3);
  }

  .role-year {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin-bottom: 0.55rem;
  }

  .role.current .role-year {
    color: var(--gold);
  }

  .role-co {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 0.85rem;
  }

  .role-co h3 {
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    letter-spacing: -0.025em;
  }

  /* One identical box for every tag. Inline boxes sized only by padding do not
     align with each other once one of them carries a border, so both get an
     explicit height, centred content, and the same 1px border (transparent on
     the filled ones). */
  .badge,
  .disc {
    display: inline-flex;
    align-items: center;
    height: 1.4rem;
    padding-inline: 0.5rem;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.53rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge {
    /* --bg, never white: white on --gold and --accent fails contrast */
    color: var(--bg);
    background: var(--gold);
  }

  .badge-accent {
    background: var(--accent);
  }

  .disc {
    color: var(--ink-2);
    border-color: var(--rule-firm);
  }

  .role-title {
    color: var(--ink-2);
    margin-top: 0.3rem;
    font-size: 1rem;
  }

  .role-title .sep {
    color: var(--ink-3);
  }

  .bullets {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.55rem;
    max-width: 62ch;
  }

  .bullets :global(li) {
    position: relative;
    padding-left: 1.15rem;
    color: var(--ink-2);
    font-size: 0.965rem;
    line-height: 1.6;
  }

  .bullets :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 6px;
    height: 1px;
    background: var(--accent);
  }

  .bullets :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .role {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      align-items: start;
    }
    .role-when {
      display: flex;
      align-items: baseline;
      gap: 0.8rem;
      flex-wrap: wrap;
    }
    .role-year {
      margin-bottom: 0;
    }
  }
</style>
